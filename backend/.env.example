# Copy to .env locally. On Hostinger, add these as environment variables in hPanel.
NODE_ENV=development
PORT=3001

# Frontend URLs allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app,https://your-domain.com

# SMTP for the contact form (Hostinger email: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@your-domain.com
SMTP_PASS=
# Where contact messages are delivered (defaults to SMTP_USER)
CONTACT_TO=
